# Copy to the project root .env or backend/.env and fill in real values locally.
# NOTE: root .env is loaded before backend/.env, so root wins on duplicate keys.
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/smartgst?retryWrites=true&w=majority
MONGODB_DATABASE=smartgst
SMARTGST_API_PORT=5000
# Optional; MongoDB stores a stable random session key if this is omitted.
SESSION_SECRET=
# Receipt OCR uses the Google Gemini API (free tier). Get a key at
# https://aistudio.google.com/apikey — leave empty to disable OCR.
# Never paste a real key into this example file; it is tracked by git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# JSON mode is only available on the v1beta API; leave this as v1beta.
GEMINI_API_VERSION=v1beta
