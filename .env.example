# Copy to .env and replace placeholders with your private Atlas connection details.
# Never commit .env or share the database password.
MONGODB_URI=mongodb+srv://<username>:<encoded-password>@<cluster-host>/smartgst?retryWrites=true&w=majority
MONGODB_DATABASE=smartgst
SMARTGST_API_PORT=5000
SESSION_SECRET=
# Receipt OCR uses the Google Gemini API. The free tier is enough; create a key at
# https://aistudio.google.com/apikey and keep it out of version control.
# Leave GEMINI_API_KEY empty to disable OCR (the manual entry form still works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# JSON mode is only available on the v1beta API; leave this as v1beta.
GEMINI_API_VERSION=v1beta
# Off by default. When true, every invoice and reminder that has no owner is
# assigned to the next account registered. Only for a single-user upgrade from
# the old SQLite prototype; on a shared instance this hands one user's records
# to a stranger.
CLAIM_LEGACY_DATA=false
