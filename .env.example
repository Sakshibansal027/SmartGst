# Copy to .env and replace placeholders with your private Atlas connection details.
# Never commit .env or share the database password.
MONGODB_URI=mongodb+srv://<username>:<encoded-password>@<cluster-host>/smartgst?retryWrites=true&w=majority
MONGODB_DATABASE=smartgst
SMARTGST_API_PORT=5000
SESSION_SECRET=
TESSERACT_PATH=
TESSERACT_LANGUAGE=eng
PDFTOPPM_PATH=pdftoppm
